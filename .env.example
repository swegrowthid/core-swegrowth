# Supabase — dua nilai ini aman untuk browser (publishable key dilindungi RLS).
# Prefix VITE_ wajib supaya Vite menyertakannya ke bundle client.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_key

# OAuth Client ID (tipe Web) yang sama dengan provider Google di Supabase. Dipakai
# tombol login Google (redirect ke /auth/google) supaya layar Google menampilkan domain kita, bukan <project-ref>.supabase.co.
# Kosong = jatuh ke redirect OAuth Supabase.
VITE_GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com

# JANGAN taruh secret/service-role key di sini: tidak ada server, semua env VITE_ ikut ke browser.
